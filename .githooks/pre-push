#!/usr/bin/env bash
# Runs the repository guard on every commit about to be pushed, so that a
# secret that was committed and removed again in a later commit is still
# caught. Then, for each pushed ref that changes Rust code (src/, tests/,
# Cargo.*), if cargo is installed, checks the formatting of the commit it
# pushes with `cargo fmt --check`, the most frequent cause of failed CI
# runs: on a copy of that commit's Rust files (`git archive`), not on the
# working tree, which may hold other changes. The tests are left to CI.
# Enable the hooks with: git config core.hooksPath .githooks
set -euo pipefail
remote=$1
root=$(git rev-parse --show-toplevel)
guard=$root/.github/scripts/repo-guard.sh
# The all-zero object name, as long as this repository's object names.
zero=$(git hash-object --stdin </dev/null | tr '0-9a-f' '0')
status=0
# the pushed commits whose formatting is checked
rust=()
while read -r local_ref local_sha remote_ref remote_sha; do
    [ "$local_sha" = "$zero" ] && continue   # deleting a ref pushes no content
    if [ "$remote_sha" != "$zero" ] && git cat-file -e "$remote_sha^{commit}" 2>/dev/null; then
        range=("$remote_sha..$local_sha")
    else
        # A new ref, or the remote has commits this clone does not know:
        # everything the remote's branches do not have yet.
        range=("$local_sha" --not --remotes="$remote")
    fi
    echo "pre-push: $local_ref -> $remote_ref"
    bash "$guard" --range "${range[@]}" </dev/null || status=1
    # Not piped into grep -q: with pipefail, git log killed by SIGPIPE
    # would make the test false.
    changed=$(git log --format= --name-only "${range[@]}" </dev/null)
    if grep -Eq '^(src/|tests/|Cargo\.)' <<<"$changed"; then
        rust+=("$local_sha")
    fi
done
if [ "${#rust[@]}" -gt 0 ] && command -v cargo >/dev/null; then
    copy=$(mktemp -d)
    trap 'rm -rf "$copy"' EXIT
    for sha in $(printf '%s\n' "${rust[@]}" | sort -u); do
        rm -rf "${copy:?}"/* "${copy:?}"/.[!.]*
        # what cargo fmt reads: the manifest, the Rust sources and the
        # rustfmt settings, if the commit has any
        paths=(Cargo.toml)
        for path in src tests rustfmt.toml .rustfmt.toml; do
            git cat-file -e "$sha:$path" 2>/dev/null && paths+=("$path")
        done
        git archive --format=tar "$sha" -- "${paths[@]}" | tar -x -C "$copy"
        if ! (cd "$copy" && cargo fmt --check) >&2; then
            echo "pre-push: the Rust code of $(git rev-parse --short "$sha") is not formatted: run cargo fmt and commit" >&2
            status=1
        fi
    done
fi
exit "$status"
